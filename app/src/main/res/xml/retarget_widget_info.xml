<?xml version="1.0" encoding="utf-8"?><!--
  Widget metadata for the Glance home-screen widget (M3.2).
  Single sized (2x2 default cells). updatePeriodMillis=0: updates are driven by
  our WorkManager tick on the notification scheduler's cadence, not the system
  (no extra wakeups — see PHASE3-AGENCY.md §3 constraints).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="140dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="320dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/glance_default_loading_layout" />
