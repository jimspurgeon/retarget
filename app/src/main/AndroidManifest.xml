<?xml version="1.0" encoding="utf-8"?>
<!--
  Retarget — manifest carries only essential permissions.
  Local-first by design: no INTERNET permission, no analytics, no trackers.
  (See DEVELOPMENT.md "Pre-registered decisions" #1 and #4.)

  POST_NOTIFICATIONS (Android 13+): required to deliver goal-focused nudges.
  Justification: Phase 2 notification channel needs this system permission.
  User control: notification nudges disabled by default; toggle in Settings.
  See AGENTS.md §1 (permission additions require documentation) and §2 (ethical guardrails).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- SET_WALLPAPER: normal (install-time) permission. Without it, WallpaperManager
         .setBitmap() throws SecurityException and rotation retries forever (v0.3.1
         regression: wallpaper channel never applied a single change). -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:name=".RetargetApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Retarget">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Check-in service for recording user check-ins from notification actions.
             NOTE: IntentService is deprecated (API 30); migrate to a coroutine-based
             approach in Phase 3 cleanup (gatekeeper F3). The BIND_JOB_SERVICE
             permission declaration is intentionally REMOVED: it is a system-held
             permission that guards JobService bindings; declaring it here made the
             service unstartable by the app itself (SecurityException). -->
        <service
            android:name=".analytics.CheckInService"
            android:exported="false" />

        <!-- Notification action handlers (Milestone 2.6) -->
        <receiver
            android:name=".broadcast.FewerNotificationsReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.retarget.action.FEWER_NOTIFICATIONS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".broadcast.CheckInReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.retarget.action.CHECK_IN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".broadcast.SnoozeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.retarget.action.SNOOZE" />
            </intent-filter>
        </receiver>

        <!-- M3.4 Wave 1: "fewer like this" feedback target. Notification
             action button lands in Wave 2; registering the receiver now
             keeps Wave 2 UI-only. -->
        <receiver
            android:name=".broadcast.FewerLikeThisReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.retarget.action.FEWER_LIKE_THIS" />
            </intent-filter>
        </receiver>

        <!-- Widget configuration screen (M3.2, gatekeeper M2 fix): goal picker
             launched by the system when the widget is added (see
             retarget_widget_info.xml android:configure). Exported because the
             launcher starts it directly; no intent-filter beyond the widget
             host's contract, no new permissions. -->
        <activity
            android:name="com.retarget.widget.WidgetConfigurationActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.Retarget" />

        <!-- Glance home-screen widget (M3.2). updatePeriodMillis is 0 in the
             widget info XML: updates are driven by our WorkManager tick on the
             same ~2h cadence as the notification scheduler — no extra wakeups.
             Exported=true is required for the system AppWidget host to bind;
             this is the standard GlanceAppWidgetReceiver pattern (no custom
             permissions, no new app permissions). -->
        <receiver
            android:name="com.retarget.widget.RetargetWidgetReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/retarget_widget_info" />
        </receiver>


    </application>

</manifest>
